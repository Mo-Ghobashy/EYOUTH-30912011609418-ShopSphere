        </mxCell>
        <mxCell id="sec_cors" value="&lt;b&gt;CORS&lt;/b&gt;&lt;br&gt;Origin locked to&lt;br&gt;frontend domain" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="710" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sec_rate" value="&lt;b&gt;Rate Limiting&lt;/b&gt;&lt;br&gt;10 req/min&lt;br&gt;on auth routes" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=center;" vertex="1" parent="1">
