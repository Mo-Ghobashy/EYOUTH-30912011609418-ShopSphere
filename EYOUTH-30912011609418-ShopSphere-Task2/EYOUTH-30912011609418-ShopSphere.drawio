          <mxGeometry x="430" y="540" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Arrow: User -> Frontend -->
        <mxCell id="arrow1" value="&lt;b&gt;HTTPS&lt;/b&gt;&lt;br&gt;GET /" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#6c8ebf;fontSize=10;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: User -> Backend -->
        <mxCell id="arrow2" value="&lt;b&gt;HTTPS&lt;/b&gt;&lt;br&gt;/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="user" target="backend">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="562" y="200" />
              <mxPoint x="580" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Arrow: Frontend -> Backend (internal API calls) -->
        <mxCell id="arrow3" value="&lt;b&gt;Internal API Calls&lt;/b&gt;&lt;br&gt;axios + VITE_API_URL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#82b366;dashed=1;fontSize=10;" edge="1" parent="1" source="frontend" target="backend">
