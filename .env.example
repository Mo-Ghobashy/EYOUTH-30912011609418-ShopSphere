# Docker Compose / shared environment
# Copy to .env in the project root: cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# Backend
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce
DIRECT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost
UPLOAD_DIR=uploads

# Email (optional — registration works without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopsphere.local

# Frontend build arg (browser must reach this URL)
VITE_API_URL=http://localhost:5000/api
